generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

/*************** Inizio Data Model ****************/

// modello basato sui dati del gateway in attesa interfaccia
model User {
    id            String   @id @default(auto()) @map("_id") @db.ObjectId
    eosId         MktEosIdType
    referenceAPP  String []     // app di riferimento da cui provnegono gli utenti
    name          String?
    email         String?  @unique
    emailVerified DateTime?
    image         String?
}

model MktPersonalizedAudience {
    id                String @id @default(auto()) @map("_id") @db.ObjectId
    userId            String @db.ObjectId // reference to user
    title             String?
    description       String?
    systemCheckflag   MktSystemCheckFlagType?
    frotnendCheckFlag MktFrontendCheckFlagType?
    personalData      MktPersonalDataType?
    fidelity          MktFidelityType?
    coupons           MktCouponsType?
    sold              String []
    userList          MktUserListType []
    software          MktSoftwareType?
    createdAt         DateTime @default(now())
    updateAt          DateTime @updatedAt
}

// Store del pubblico personalizzato eliminato 
model MktDeletedPersonalizedAudience {
    id                     String @id @default(auto()) @map("_id") @db.ObjectId
    personalizedAudienceId String @db.ObjectId // reference to MktPresolaziedAudience
    createdAt              DateTime @default(now())
    updateAt               DateTime @updatedAt
}

/********************************************/


/*************** Inizio Type Section ****************/

type MktEosIdType { // reference => EOS Mapper
    eosId    String
    software String
}

type MktSoftwareType {
    signWow         Boolean @default(false)
    wowCommerce     Boolean @default(false)
    appMobile       Boolean @default(false)
    webAppSelfOrder Boolean @default(false)
    webAppPagamento Boolean @default(false)
    bacco           Boolean @default(false)
}

type MktPersonalDataType {
    name                    MktComparisonType [] 
    surname                 MktComparisonType []
    birthDay                MktbirthDayPersonalDataEnum? // compleanno ne verrà selezioanto solo uno, da chiedere a carlo
    age                     MktAgeType [] 
    gender                  MktGenderEnum? 
    userActivationDate      MktDateType[]
    acceptedMarketingPolicy Boolean? @default(false)
    acceptedGDPR            Boolean? @default(false)
}

type MktSystemCheckFlagType {
    operationIsActive    Boolean @default(false)
    personalizedIsActive Boolean @default(false)
    isDeleted            Boolean @default(false)
}

type MktFrontendCheckFlagType {
    AudienceMoreUsed MktAudienceMoreUsedType?
    isActivePersonalData Boolean? @default(false)
    isActiveFidelity     Boolean? @default(false)
    isActiveCoupons      Boolean? @default(false)
    isActiveSold         Boolean? @default(false)
    isActiveUserList     Boolean? @default(false)
    isActiveSoftware     Boolean? @default(false)

}

type MktAudienceMoreUsedType {
    isActiveTodayBirthday                Boolean @default(false)
    isActiveMonthBirthday                Boolean @default(false)
    isActiveOverTwoHundredShopping       Boolean @default(false)
    isActiveOverTenOrder                 Boolean @default(false)
    isActiveFideltyBalanceOverOneHundred Boolean @default(false)
    isActiveAppMobileActiveLastMonth     Boolean @default(false)
}

type MktAgeType {
    operator MktOperatorEnum? @default(EQUAL)
    age      Int?
}

type MktFidelityType {
    campainActivityBalance MktCampainActivityBalanceType []
    transactionFidelty     MktTransactionFidelityCardType []
}

type MktCampainActivityBalanceType {
    campaignId            String [] @default([]) // reference to user campain
    campainLabel          String
    activityId            String [] @default([]) // reference to user activity
    activityLabel         String
    balanceOperator     MktOperatorEnum?
    balance             Float?
    balanceFidelityDate MktDateType []
}

//valutare se i capi data vanno aggiunti nel type o nel model
type MktTransactionFidelityCardType{
    operator MktOperatorEnum
    value    Int
    transactionDate MktDateType []
}

type MktCouponsType {
    couponNameId String [] // reference to user coupons
    couponLabel String
    achievements MktCouponsAchievementsType
    burns        MktCouponsBurnType
    expired      Boolean @default(false)
}

type MktCouponsAchievementsType {
    isOtained              Boolean? @default(false)
    achievementsComparison MktComparisonType?
    value                  Float? @default(0.0)
    achievementsDate       MktDateType?
}

type MktCouponsBurnType {
    isBurned       Boolean? @default(false)
    burnComparison MktComparisonType?
    value          Float? @default(0.0)
    burnedDate     MktDateType?
}

type MktCouponsExpirationType {
    isExpired            Boolean? @default(false)
    expirationComparison MktComparisonType?
    value                Float? @default(0.0)
    expiredData          MktPersonalDataType? // da chiedere se la data ha lo stesso di burn e achievements
}

type MktRangeDateType {
    beginDate      DateTime
    endDate        DateTime
}

type MktDateType {
    dateRange      MktRangeDateType?
    isAutoUpdate   Boolean? @default(false)
    advancedMode   MktAdvancedDateType?
}

// mdoalità scassacazzi -_-'
type MktAdvancedDateType {
    isAdvancedMode Boolean? @default(false)
    comparison     MktAdvancedDateComparisonEnum?
    day            MktAdvancedFieldDateDayType?
    month          MktAdvancedFieldDateMonthType?
    year           MktAdvancedFieldDateYearType?
}

type MktConditionsType {
    operator      MktOperatorEnum @default(ALL)
    mktConditions String
}

type MktComparisonType {
    operator MktOperatorEnum? @default(CONATINS)
    value    String?
}

type MktAdvancedFieldDateDayType {
    any          Boolean  @default(false)
    today        Int?     @default(0)
    personalized DateTime @default(now()) // da chidere se impostano l'anno   
}
// da cambiare il personalized
type MktAdvancedFieldDateMonthType {
    any          Boolean  @default(false)
    today        Int?     @default(0)  
    personalized DateTime @default(now()) 
}

type MktAdvancedFieldDateYearType {
    any          Boolean  @default(false)
    today        Int?     @default(0) 
    personalized DateTime @default(now())
}

type MktUserListType {
    id          String? // refrerence to id
    name        String? 
    email       String?
    bornDate    DateTime?
    phoneNumber String?
    address     String?
}

// prototipo
type MktNotificationsType {
    eosClientId           String[]
    title                 String
    desc                  String
    scheduleDate          DateTime //data in cui inoltrare notifica
    NumberClienttSelected Int
    sendStatus            Int
}

/********************************************/


/*************** Inizio Enum Section ****************/

enum MktGenderEnum {
    MALE    
    FEMALE
    OTHER
}

enum MktOperatorEnum {
    PLUS
    EQUAL
    MINUS
    ALL    
    CONATINS
    FALSE
}

enum MktbirthDayPersonalDataEnum {
    TODAY
    THISWEEK
    THISMONTH
}

enum MktAdvancedDateComparisonEnum {
    EXACTLY
    AFTER
    BEFORE
}

