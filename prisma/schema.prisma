// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}



// modello basato sui dati del gateway
model User {
    id            String   @id @default(auto()) @map("_id") @db.ObjectId
    eosId         String
    name          String?
    email         String?  @unique
    emailVerified DateTime?
    image         String?
}


model MktPersonalizedAudience {
 id                   String @id @default(auto()) @map("_id") @db.ObjectId
 eosId                String @unique //reference to EOS Mapper id
 audienceMoreUsed     MktAudienceMoreUsedType
 personalizedAudience Boolean @default(false)
 createdAt            DateTime @default(now())
 updateAt             DateTime @updatedAt
}

type MktAudienceMoreUsedType {
    todayBirthday  Boolean @default(false)
    monthBirthday Boolean @default(false)
    overTwoHundredShopping Boolean @default(false)
    overTenOrder Boolean @default(false)
    fideltyBalanceOverOneHundred Boolean @default(false)
    appMobileActiveLastMonth Boolean @default(false)
}

enum genderEnum {
    MALE    
    FEMALE
}//r

enum mktOperatorEnum {
    PLUS
    EQUAL
    MINUS
    ALL
    FALSE
}

type mktConditions {
    operator mktOperatorEnum @default(ALL)
    mktConditions String
}


//valutare se i capi data vanno aggiunti nel type o nel model
type MktUserPersonalDataType {
    name String
    surname String
    birthDay DateTime
    age Int
    gender genderEnum @default(MALE)
    activationDate DateTime
    acceptedMarketingPolicy Boolean
    acceptedGDPR Boolean
}
//valutare se i capi data vanno aggiunti nel type o nel model
type MktFidelityType {
  campaign String
  activity String
  operator mktOperatorEnum
  balance Float
}

//valutare se i capi data vanno aggiunti nel type o nel model
type MktTransactionFidelityCardType{
    operator mktOperatorEnum
    value Int
}

type MktCouponsType {
name String 
isOtained Boolean @default(false)
burned MktBurnType
expired Boolean @default(false)
}

type MktBurnType {
    isBurned Boolean @default(false)
    vlaue Float @default(0.0)
    dateRange MktDateType
}

type MktDateType {
    beginDate DateTime
    endDate DateTime
}

